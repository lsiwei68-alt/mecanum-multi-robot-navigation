<?xml version="1.0"?>
<sdf version="1.8">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><surface><friction><ode><mu>20</mu><mu2>20</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Six connected wall segments create two rooms and a 1.1 m corridor. -->
    <model name="lower_left_shoulder"><static>true</static><pose>-2.725 -2.15 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.35 0.3 1</size></box></geometry></collision><visual name="v"><geometry><box><size>4.35 0.3 1</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.75 0.32 0.12 1</diffuse></material></visual></link></model>
    <model name="lower_right_shoulder"><static>true</static><pose>2.725 -2.15 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.35 0.3 1</size></box></geometry></collision><visual name="v"><geometry><box><size>4.35 0.3 1</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.75 0.32 0.12 1</diffuse></material></visual></link></model>
    <model name="corridor_left_wall"><static>true</static><pose>-0.7 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.3 4.0 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 4.0 1</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.75 0.32 0.12 1</diffuse></material></visual></link></model>
    <model name="corridor_right_wall"><static>true</static><pose>0.7 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.3 4.0 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 4.0 1</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.75 0.32 0.12 1</diffuse></material></visual></link></model>
    <model name="upper_left_shoulder"><static>true</static><pose>-2.725 2.15 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.35 0.3 1</size></box></geometry></collision><visual name="v"><geometry><box><size>4.35 0.3 1</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.75 0.32 0.12 1</diffuse></material></visual></link></model>
    <model name="upper_right_shoulder"><static>true</static><pose>2.725 2.15 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.35 0.3 1</size></box></geometry></collision><visual name="v"><geometry><box><size>4.35 0.3 1</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.75 0.32 0.12 1</diffuse></material></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 10.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10.2 1</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 10.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10.2 1</size></box></geometry></visual></link></model>
  </world>
</sdf>
