<?xml version="1.0"?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:ignition="http://ignitionrobotics.org/schema">
  <xacro:arg name="namespace" default="robot1"/>
  <xacro:arg name="native_lidar" default="false"/>
  <xacro:property name="ns" value="$(arg namespace)"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_x" value="0.18"/>
  <xacro:property name="wheel_y" value="0.235"/>

  <model name="${ns}">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.16</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.24</iyy><iyz>0</iyz><izz>0.34</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.48 0.36 0.14</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.48 0.36 0.14</size></box></geometry>
        <material>
          <ambient>0.08 0.32 0.75 1</ambient>
          <diffuse>0.10 0.42 0.95 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <xacro:macro name="wheel" params="name x y roller_x roller_y">
      <link name="${name}_wheel">
        <pose>${x} ${y} ${wheel_radius} -1.57079632679 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.0016</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0016</iyy><iyz>0</iyz><izz>0.0020</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>${wheel_radius}</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">${roller_x} ${roller_y} 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>${wheel_radius}</radius><length>0.055</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.10 0.10 0.10 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="${name}_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>${name}_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>
    </xacro:macro>

    <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"  roller_x="1" roller_y="-1"/>
    <xacro:wheel name="front_right" x="${wheel_x}"  y="-${wheel_y}" roller_x="1" roller_y="1"/>
    <xacro:wheel name="rear_left"   x="-${wheel_x}" y="${wheel_y}"  roller_x="1" roller_y="1"/>
    <xacro:wheel name="rear_right"  x="-${wheel_x}" y="-${wheel_y}" roller_x="1" roller_y="-1"/>

    <link name="lidar_link">
      <pose>0 0 0.29 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz><izz>0.0002</izz>
        </inertia>
      </inertial>
      <!-- Ogre1 GPU lidar may include visuals from its own link in the render
           pass. Hide the housing in native-lidar mode so no beam can hit it.
           RViz publishes a separate visualization marker for the housing. -->
      <xacro:unless value="$(arg native_lidar)">
        <visual name="visual">
          <geometry><cylinder><radius>0.045</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </xacro:unless>
      <xacro:if value="$(arg native_lidar)">
        <sensor name="gpu_lidar" type="gpu_lidar">
          <topic>/${ns}/scan</topic>
          <gz_frame_id>${ns}/lidar_link</gz_frame_id>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265359</min_angle>
                <max_angle>3.14159265359</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.12</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>
      </xacro:if>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <plugin filename="ignition-gazebo-mecanum-drive-system"
            name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>${2.0 * wheel_y}</wheel_separation>
      <wheelbase>${2.0 * wheel_x}</wheelbase>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>/${ns}/cmd_vel</topic>
    </plugin>

    <!-- Fortress' MecanumDrive motion output is paired with the generic,
         well-tested odometry publisher. This avoids a Fortress bug where a
         custom mecanum odom topic can be advertised without sending data. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>${ns}/odom</odom_frame>
      <robot_base_frame>${ns}/base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/${ns}/odom</odom_topic>
      <tf_topic>/${ns}/tf</tf_topic>
      <dimensions>2</dimensions>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
    </plugin>
  </model>
</sdf>
