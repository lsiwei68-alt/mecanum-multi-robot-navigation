Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /Global Navigation1
        - /Local Navigation1
    Tree Height: 650
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 120; 120; 120
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: map
      Use Timestamp: false
    - Class: rviz_default_plugins/LaserScan
      Name: Peer-aware Laser Scan
      Enabled: true
      Alpha: 1
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: scan
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Odometry
      Name: Robot Pose
      Enabled: true
      Keep: 1
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
      Shape:
        Alpha: 1
        Color: 0; 255; 80
        Head Length: 0.25
        Head Radius: 0.12
        Shaft Length: 0.45
        Shaft Radius: 0.06
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: odom
    - Class: rviz_common/Group
      Name: Global Navigation
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Alpha: 0.28
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: global_costmap/costmap
          Use Timestamp: false
        - Class: rviz_default_plugins/Path
          Name: Global Path
          Enabled: true
          Alpha: 1
          Buffer Length: 1
          Color: 255; 40; 40
          Line Style: Lines
          Line Width: 0.04
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: plan
    - Class: rviz_common/Group
      Name: Local Navigation
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Alpha: 0.65
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: local_costmap/costmap
          Use Timestamp: false
        - Class: rviz_default_plugins/Path
          Name: Local Path
          Enabled: true
          Alpha: 1
          Buffer Length: 1
          Color: 0; 180; 255
          Line Style: Lines
          Line Width: 0.06
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: local_plan
        - Class: rviz_default_plugins/Polygon
          Name: Robot Footprint
          Enabled: true
          Alpha: 1
          Color: 0; 255; 80
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: local_costmap/published_footprint
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 90
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
Window Geometry:
  Height: 850
  Width: 1100
