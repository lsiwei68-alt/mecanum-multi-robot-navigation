#!/usr/bin/env python3
"""Generic online two-robot spatiotemporal coordinator.

The narrow passage is only a test scene. This node does not know its location:
it plans both routes, repeatedly predicts their remaining arrival times, detects
overlapping space-time occupancy, and temporarily yields one robot at a safe
path point.  Reservations are released from measured execution progress.
"""

from copy import deepcopy
from dataclasses import dataclass
import math
import sys
import time

from geometry_msgs.msg import Point, PoseStamped
from mecanum_multi_nav.nav2_readiness import start_navigation, wait_for_nav2
from nav2_simple_commander.robot_navigator import BasicNavigator, TaskResult
from nav_msgs.msg import Path
import rclpy
from rclpy.duration import Duration
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import String
from visualization_msgs.msg import Marker, MarkerArray


@dataclass
class TimedSample:
    index: int
    x: float
    y: float
    time: float


@dataclass
class Conflict:
    index1: int
    index2: int
    x: float
    y: float
    time1: float
    time2: float


@dataclass
class RobotRuntime:
    name: str
    navigator: object
    path: Path
    samples: list
    goal: PoseStamped
    x: float
    y: float
    speed: float
    progress: int = 0
    mode: str = 'goal'
    active: bool = False
    final_done: bool = False
    result: object = None
    last_x: float = None
    last_y: float = None
    last_stamp: float = None
    plan_subscription: object = None
    plan_revision: int = 0


def make_pose(navigator, x, y, yaw=0.0):
    pose = PoseStamped()
    pose.header.frame_id = 'map'
    pose.header.stamp = navigator.get_clock().now().to_msg()
    pose.pose.position.x = float(x)
    pose.pose.position.y = float(y)
    pose.pose.orientation.z = math.sin(yaw / 2.0)
    pose.pose.orientation.w = math.cos(yaw / 2.0)
    return pose


def timed_samples(path, nominal_speed):
    samples = []
    elapsed = 0.0
    previous = None
    for index, pose in enumerate(path.poses):
        point = pose.pose.position
        if previous is not None:
            elapsed += math.hypot(
                point.x - previous.x, point.y - previous.y) / nominal_speed
        samples.append(TimedSample(index, point.x, point.y, elapsed))
        previous = point
    return samples


def remaining_timed_samples(robot, minimum_speed, maximum_speed,
                            speed_override=None):
    """Retimestamp the untraversed path from the robot's measured state."""
    prediction_speed = (robot.speed if speed_override is None
                        else speed_override)
    speed = min(max(prediction_speed, minimum_speed), maximum_speed)
    elapsed = 0.0
    previous_x = robot.x
    previous_y = robot.y
    remaining = []
    for sample in robot.samples[robot.progress:]:
        elapsed += math.hypot(
            sample.x - previous_x, sample.y - previous_y) / speed
        remaining.append(TimedSample(
            sample.index, sample.x, sample.y, elapsed))
        previous_x = sample.x
        previous_y = sample.y
    return remaining


def update_live_path(robot, path, nominal_speed):
    """Track Nav2 replans for final-goal navigation, ignoring hold paths."""
    if robot.mode != 'goal' or not path.poses:
        return
    endpoint = path.poses[-1].pose.position
    goal = robot.goal.pose.position
    if math.hypot(endpoint.x - goal.x, endpoint.y - goal.y) > 0.35:
        return
    robot.path = deepcopy(path)
    robot.samples = timed_samples(robot.path, nominal_speed)
    robot.progress = nearest_progress(
        robot.samples, robot.x, robot.y, 0)
    robot.plan_revision += 1
    if robot.plan_revision == 1:
        robot.navigator.get_logger().info(
            f'[SCHEDULER] LIVE_PLAN_TRACKING: {robot.name} 已接入 Nav2 实时全局路径')


def subscribe_to_live_plans(robots, nominal_speed):
    """Subscribe to each namespaced Nav2 planner's latest global path."""
    for robot in robots.values():
        robot.plan_subscription = robot.navigator.create_subscription(
            Path,
            'plan',
            lambda path, current=robot: update_live_path(
                current, path, nominal_speed),
            10)


def stamp_remaining_path(path, samples, node):
    predicted = Path()
    predicted.header.frame_id = path.header.frame_id
    start = node.get_clock().now()
    predicted.header.stamp = start.to_msg()
    for sample in samples:
        pose = deepcopy(path.poses[sample.index])
        pose.header.stamp = (start + Duration(seconds=sample.time)).to_msg()
        predicted.poses.append(pose)
    return predicted


def find_conflicts(samples1, samples2, clearance, time_margin):
    """Find conflicts with a sliding temporal window over sorted samples."""
    conflicts = []
    window_start = 0
    for sample1 in samples1:
        # The epsilon only broadens the candidate window.  The exact check
        # below preserves the original boundary behavior for floating point
        # timestamps.
        earliest = sample1.time - time_margin - 1e-9
        latest = sample1.time + time_margin + 1e-9
        while (window_start < len(samples2) and
               samples2[window_start].time < earliest):
            window_start += 1
        index2 = window_start
        while index2 < len(samples2) and samples2[index2].time <= latest:
            sample2 = samples2[index2]
            if abs(sample1.time - sample2.time) > time_margin:
                index2 += 1
                continue
            distance = math.hypot(sample1.x - sample2.x, sample1.y - sample2.y)
            if distance <= clearance:
                conflicts.append(Conflict(
                    sample1.index, sample2.index,
                    (sample1.x + sample2.x) / 2.0,
                    (sample1.y + sample2.y) / 2.0,
                    sample1.time, sample2.time))
            index2 += 1
    return conflicts


def thin_timed_samples(samples, minimum_distance=0.12,
                       maximum_time_gap=0.50):
    """Reduce dense planner paths while preserving spatial and temporal shape."""
    if len(samples) <= 2:
        return samples
    reduced = [samples[0]]
    for sample in samples[1:-1]:
        previous = reduced[-1]
        distance = math.hypot(
            sample.x - previous.x, sample.y - previous.y)
        if (distance >= minimum_distance or
                sample.time - previous.time >= maximum_time_gap):
            reduced.append(sample)
    reduced.append(samples[-1])
    return reduced


def detect_conflicts(samples1, samples2, clearance, time_margin):
    """Run conflict detection on bounded-resolution trajectory samples."""
    return find_conflicts(
        thin_timed_samples(samples1), thin_timed_samples(samples2),
        clearance, time_margin)


def index_before_distance(samples, conflict_index, distance):
    index = min(
        range(len(samples)),
        key=lambda position: abs(samples[position].index - conflict_index))
    target = samples[index]
    while index > 0:
        candidate = samples[index]
        if math.hypot(candidate.x - target.x, candidate.y - target.y) >= distance:
            return candidate.index
        index -= 1
    return samples[0].index


def nearest_progress(samples, x, y, previous_index):
    start = max(0, previous_index - 5)
    nearest = min(
        range(start, len(samples)),
        key=lambda index: math.hypot(
            samples[index].x - x, samples[index].y - y))
    return max(previous_index, nearest)


def result_name(result):
    if result == TaskResult.SUCCEEDED:
        return 'SUCCEEDED'
    if result == TaskResult.CANCELED:
        return 'CANCELED'
    if result == TaskResult.FAILED:
        return 'FAILED'
    return f'UNKNOWN({result})'


class SchedulerView:
    def __init__(self, node):
        qos = QoSProfile(depth=1)
        qos.reliability = ReliabilityPolicy.RELIABLE
        qos.durability = DurabilityPolicy.TRANSIENT_LOCAL
        self.node = node
        self.state_publisher = node.create_publisher(
            String, '/coordination/state', qos)
        self.marker_publisher = node.create_publisher(
            MarkerArray, '/coordination/markers', qos)
        self.path_publishers = {
            'robot1': node.create_publisher(
                Path, '/coordination/robot1_predicted_path', qos),
            'robot2': node.create_publisher(
                Path, '/coordination/robot2_predicted_path', qos),
        }
        self.paths = {}
        self.conflicts = []
        self.hold_point = None
        self.last_state = None

    def set_plan(self, path1, path2, conflicts, hold_point=None):
        self.paths = {'robot1': path1, 'robot2': path2}
        self.conflicts = conflicts
        self.hold_point = hold_point

    def publish(self, state, detail, released=False):
        if state != self.last_state:
            self.node.get_logger().info(f'[SCHEDULER] {state}: {detail}')
            self.last_state = state
        message = String()
        message.data = f'{state}: {detail}'
        self.state_publisher.publish(message)
        for name, path in self.paths.items():
            self.path_publishers[name].publish(path)
        self._publish_markers(state, detail, released)

    def _publish_markers(self, state, detail, released):
        now = self.node.get_clock().now().to_msg()
        markers = MarkerArray()
        colors = {
            'robot1': (0.10, 0.45, 1.0),
            'robot2': (1.0, 0.45, 0.08),
        }
        for marker_id, name in enumerate(('robot1', 'robot2'), start=10):
            if name not in self.paths:
                continue
            marker = Marker()
            marker.header.frame_id = 'map'
            marker.header.stamp = now
            marker.ns = 'predicted_trajectories'
            marker.id = marker_id
            marker.type = Marker.LINE_STRIP
            marker.action = Marker.ADD
            marker.scale.x = 0.055
            marker.color.r, marker.color.g, marker.color.b = colors[name]
            marker.color.a = 0.9
            marker.points = [deepcopy(pose.pose.position)
                             for pose in self.paths[name].poses]
            markers.markers.append(marker)

        conflict_marker = Marker()
        conflict_marker.header.frame_id = 'map'
        conflict_marker.header.stamp = now
        conflict_marker.ns = 'detected_conflicts'
        conflict_marker.id = 20
        conflict_marker.type = Marker.SPHERE_LIST
        conflict_marker.action = Marker.ADD
        # Keep the zone clearly above maps, costmaps, and path lines in the
        # top-down RViz view.  Red means reserved conflict; green means the
        # reservation has been released.
        conflict_marker.scale.x = 0.21
        conflict_marker.scale.y = 0.21
        conflict_marker.scale.z = 0.09
        conflict_marker.color.r = 0.1 if released else 1.0
        conflict_marker.color.g = 0.9 if released else 0.1
        conflict_marker.color.b = 0.1
        conflict_marker.color.a = 0.88
        stride = max(1, len(self.conflicts) // 80)
        for conflict in self.conflicts[::stride]:
            conflict_marker.points.append(
                Point(x=conflict.x, y=conflict.y, z=0.11))
        markers.markers.append(conflict_marker)

        if self.hold_point is not None:
            hold = Marker()
            hold.header.frame_id = 'map'
            hold.header.stamp = now
            hold.ns = 'yield_point'
            hold.id = 21
            hold.type = Marker.CYLINDER
            hold.action = Marker.ADD
            hold.pose.position.x = self.hold_point.pose.position.x
            hold.pose.position.y = self.hold_point.pose.position.y
            hold.pose.position.z = 0.04
            hold.pose.orientation.w = 1.0
            hold.scale.x = 0.45
            hold.scale.y = 0.45
            hold.scale.z = 0.06
            hold.color.r = 1.0
            hold.color.g = 0.8
            hold.color.b = 0.05
            hold.color.a = 0.8
            markers.markers.append(hold)

        panel = Marker()
        panel.header.frame_id = 'map'
        panel.header.stamp = now
        panel.ns = 'coordination_state'
        panel.id = 22
        panel.type = Marker.CUBE
        panel.action = Marker.ADD
        panel.pose.position.x = -3.55
        panel.pose.position.y = 4.25
        panel.pose.position.z = 0.035
        panel.pose.orientation.w = 1.0
        panel.scale.x = 2.75
        panel.scale.y = 0.90
        panel.scale.z = 0.035
        panel.color.r = 0.02
        panel.color.g = 0.04
        panel.color.b = 0.09
        panel.color.a = 0.72
        markers.markers.append(panel)

        label = Marker()
        label.header.frame_id = 'map'
        label.header.stamp = now
        label.ns = 'coordination_state'
        label.id = 23
        label.type = Marker.TEXT_VIEW_FACING
        label.action = Marker.ADD
        label.pose.position.x = panel.pose.position.x
        label.pose.position.y = panel.pose.position.y
        label.pose.position.z = 0.12
        label.pose.orientation.w = 1.0
        label.scale.z = 0.19
        label.color.r = 0.35
        label.color.g = 0.90
        label.color.b = 1.0
        label.color.a = 1.0
        state_labels = {
            'WAITING_FOR_NAV2': 'Waiting for Nav2',
            'PLANNING_TRAJECTORIES': 'Planning both routes',
            'ONLINE_MONITORING': 'Monitoring both robots',
            'ONLINE_CONFLICT_DETECTED': 'Conflict detected',
            'ONLINE_YIELDING': 'Reservation active - one robot yielding',
            'ONLINE_RELEASE_PENDING': 'Release safety confirmation',
            'ONLINE_RESERVATION_RELEASED': 'Reservation released',
            'ONLINE_CLEAR': 'Conflict cleared - monitoring',
            'COMPLETE': 'Both robots arrived',
            'FAILED': 'Navigation failed',
        }
        if state == 'COMPLETE' or released:
            label.color.r = 0.25
            label.color.g = 1.0
            label.color.b = 0.35
        elif self.conflicts:
            label.color.r = 1.0
            label.color.g = 0.35
            label.color.b = 0.25
        if not self.conflicts:
            zone_state = 'Conflict zone: none'
        elif released:
            zone_state = 'Conflict zone: RELEASED (green)'
        else:
            zone_state = 'Conflict zone: RESERVED (red)'
        state_text = state_labels.get(state, state.replace('_', ' ').title())
        label.text = f'ONLINE SCHEDULER\n{state_text}\n{zone_state}'
        markers.markers.append(label)
        self.marker_publisher.publish(markers)


def choose_priority(conflicts, priorities):
    first = min(conflicts, key=lambda item: max(item.time1, item.time2))
    if priorities['robot1'] != priorities['robot2']:
        if priorities['robot1'] > priorities['robot2']:
            return 'robot1', 'robot2'
        return 'robot2', 'robot1'
    if abs(first.time1 - first.time2) > 0.25:
        if first.time1 < first.time2:
            return 'robot1', 'robot2'
        return 'robot2', 'robot1'
    return 'robot1', 'robot2'


def update_runtime(robot, minimum_speed, maximum_speed):
    """Spin one navigator and update measured pose, speed, and path progress."""
    if robot.active:
        complete = robot.navigator.isTaskComplete()
        feedback = robot.navigator.getFeedback()
        if feedback is not None:
            point = feedback.current_pose.pose.position
            now = robot.navigator.get_clock().now().nanoseconds / 1e9
            if robot.last_stamp is not None and now > robot.last_stamp:
                distance = math.hypot(
                    point.x - robot.last_x, point.y - robot.last_y)
                measured = distance / (now - robot.last_stamp)
                measured = min(max(measured, 0.0), maximum_speed)
                robot.speed = max(
                    minimum_speed, 0.7 * robot.speed + 0.3 * measured)
            robot.x = point.x
            robot.y = point.y
            robot.last_x = point.x
            robot.last_y = point.y
            robot.last_stamp = now
            robot.progress = nearest_progress(
                robot.samples, robot.x, robot.y, robot.progress)
        if complete:
            robot.active = False
            robot.result = robot.navigator.getResult()
            if robot.mode == 'goal':
                if robot.result != TaskResult.SUCCEEDED:
                    raise RuntimeError(
                        f'{robot.name} navigation failed: '
                        f'{result_name(robot.result)}')
                robot.final_done = True
                robot.progress = len(robot.samples) - 1
            elif robot.result != TaskResult.SUCCEEDED:
                raise RuntimeError(
                    f'{robot.name} failed to reach online hold point: '
                    f'{result_name(robot.result)}')


def command_goal(robot):
    robot.mode = 'goal'
    start_navigation(robot.navigator, robot.goal)
    robot.active = True


def cancel_active_navigation(robot, timeout=5.0):
    """Cancel and drain the old action result before replacing its goal."""
    if not robot.active:
        return
    robot.navigator.cancelTask()
    deadline = time.monotonic() + timeout
    while rclpy.ok() and not robot.navigator.isTaskComplete():
        if time.monotonic() >= deadline:
            raise TimeoutError(
                f'timed out canceling {robot.name} {robot.mode} goal')
        time.sleep(0.05)
    robot.active = False
    robot.result = None


def command_hold(robot, hold_pose):
    cancel_active_navigation(robot)
    robot.mode = 'hold'
    start_navigation(robot.navigator, hold_pose)
    robot.active = True


def stop_for_reservation(robot):
    cancel_active_navigation(robot)
    robot.mode = 'hold'
    robot.active = False


def online_predictions(robots, node, minimum_speed, maximum_speed):
    timed = {
        name: remaining_timed_samples(
            robot, minimum_speed, maximum_speed)
        for name, robot in robots.items()
    }
    predicted = {
        name: stamp_remaining_path(robot.path, timed[name], node)
        for name, robot in robots.items()
    }
    return timed, predicted


def extend_finished_robot_occupancy(robots, timed, time_margin):
    """Model a robot parked at its goal for the other robot's horizon."""
    for name, robot in robots.items():
        if not robot.final_done:
            continue
        other_name = 'robot2' if name == 'robot1' else 'robot1'
        other_horizon = timed[other_name][-1].time if timed[other_name] else 0.0
        horizon = other_horizon + time_margin
        sample_index = robot.progress
        timed[name] = [TimedSample(
            sample_index, robot.x, robot.y, step * 0.5)
            for step in range(int(horizon / 0.5) + 1)]


def release_now_predictions(robots, yielding, node, parameters):
    """Predict both trajectories under the counterfactual: release now."""
    minimum_speed = float(parameters['minimum_prediction_speed'])
    maximum_speed = float(parameters['maximum_prediction_speed'])
    nominal_speed = float(parameters['nominal_speed'])
    timed = {}
    for name, robot in robots.items():
        speed_override = nominal_speed if name == yielding else None
        timed[name] = remaining_timed_samples(
            robot, minimum_speed, maximum_speed, speed_override)
    extend_finished_robot_occupancy(
        robots, timed, float(parameters['time_margin']))
    predicted = {
        name: stamp_remaining_path(robot.path, timed[name], node)
        for name, robot in robots.items()
    }
    return timed, predicted


def run_online_coordination(robots, view, parameters):
    """Continuously reschedule two independently planned Nav2 trajectories."""
    names = ('robot1', 'robot2')
    priorities = {
        name: int(parameters[f'{name}_priority']) for name in names
    }
    minimum_speed = float(parameters['minimum_prediction_speed'])
    maximum_speed = float(parameters['maximum_prediction_speed'])
    clearance = float(parameters['clearance'])
    time_margin = float(parameters['time_margin'])
    emergency_clearance = float(parameters['emergency_clearance'])
    release_min_separation = max(
        emergency_clearance,
        float(parameters['release_min_separation']))
    release_confirmation_cycles = max(
        1, int(parameters['release_confirmation_cycles']))
    period = float(parameters['online_period'])
    timeout = float(parameters['timeout'])

    for robot in robots.values():
        command_goal(robot)

    reservation = None
    last_released = None
    release_visible_until = 0.0
    started = time.monotonic()

    while rclpy.ok() and not all(
            robot.final_done for robot in robots.values()):
        for robot in robots.values():
            update_runtime(robot, minimum_speed, maximum_speed)
        if time.monotonic() - started > timeout:
            raise TimeoutError('online coordination timed out')

        timed, predicted = online_predictions(
            robots, view.node, minimum_speed, maximum_speed)
        conflicts = []
        if timed['robot1'] and timed['robot2']:
            conflicts = detect_conflicts(
                timed['robot1'], timed['robot2'], clearance, time_margin)

        separation = math.hypot(
            robots['robot1'].x - robots['robot2'].x,
            robots['robot1'].y - robots['robot2'].y)
        if not conflicts and separation <= emergency_clearance:
            conflicts = [Conflict(
                robots['robot1'].samples[robots['robot1'].progress].index,
                robots['robot2'].samples[robots['robot2'].progress].index,
                (robots['robot1'].x + robots['robot2'].x) / 2.0,
                (robots['robot1'].y + robots['robot2'].y) / 2.0,
                0.0, 0.0)]

        if reservation is None and conflicts:
            granted, yielding = choose_priority(conflicts, priorities)
            conflict_indices = {
                'robot1': [item.index1 for item in conflicts],
                'robot2': [item.index2 for item in conflicts],
            }
            hold_index = index_before_distance(
                robots[yielding].samples,
                min(conflict_indices[yielding]),
                float(parameters['hold_distance']))
            hold_pose = deepcopy(robots[yielding].path.poses[hold_index])
            hold_ahead = hold_index > robots[yielding].progress + 2
            if hold_ahead:
                command_hold(robots[yielding], hold_pose)
                hold_detail = '前往动态等待点'
            else:
                stop_for_reservation(robots[yielding])
                hold_pose = make_pose(
                    robots[yielding].navigator,
                    robots[yielding].x, robots[yielding].y)
                hold_detail = '立即停车等待'
            reservation = {
                'granted': granted,
                'yielding': yielding,
                'conflicts': conflicts,
                'last_conflicts': conflicts,
                'hold_pose': hold_pose,
                'clear_cycles': 0,
            }
            view.set_plan(
                predicted['robot1'], predicted['robot2'],
                conflicts, hold_pose)
            first_time = min(
                max(item.time1, item.time2) for item in conflicts)
            view.publish(
                'ONLINE_CONFLICT_DETECTED',
                f't={first_time:.1f}s 动态冲突；{granted} 通行，'
                f'{yielding} {hold_detail}')

        if reservation is not None:
            granted = reservation['granted']
            yielding = reservation['yielding']
            release_timed, release_predicted = release_now_predictions(
                robots, yielding, view.node, parameters)
            release_conflicts = detect_conflicts(
                release_timed['robot1'], release_timed['robot2'],
                clearance, time_margin)
            if release_conflicts:
                reservation['last_conflicts'] = release_conflicts
            prediction_clear = not release_conflicts
            physically_clear = separation >= release_min_separation
            if prediction_clear and physically_clear:
                reservation['clear_cycles'] += 1
            else:
                reservation['clear_cycles'] = 0
            cleared = (
                reservation['clear_cycles'] >= release_confirmation_cycles)
            if cleared:
                if not robots[yielding].final_done:
                    cancel_active_navigation(robots[yielding])
                    command_goal(robots[yielding])
                reservation['conflicts'] = reservation['last_conflicts']
                last_released = reservation
                release_visible_until = time.monotonic() + 3.0
                reservation = None
                view.publish(
                    'ONLINE_RESERVATION_RELEASED',
                    f'{granted} 已清空动态冲突区；放行 {yielding}',
                    released=True)
            elif prediction_clear:
                view.set_plan(
                    release_predicted['robot1'],
                    release_predicted['robot2'], [],
                    reservation['hold_pose'])
                if physically_clear:
                    release_detail = (
                        f'放行预测已安全；确认 '
                        f'{reservation["clear_cycles"]}/'
                        f'{release_confirmation_cycles}')
                else:
                    release_detail = (
                        f'预测无冲突；等待实际车距 '
                        f'{separation:.2f}/{release_min_separation:.2f} m')
                view.publish(
                    'ONLINE_RELEASE_PENDING',
                    release_detail)
            else:
                reservation['conflicts'] = release_conflicts
                view.set_plan(
                    release_predicted['robot1'],
                    release_predicted['robot2'],
                    release_conflicts, reservation['hold_pose'])
                view.publish(
                    'ONLINE_YIELDING',
                    f'{yielding} 让行；实时模拟当前放行仍有冲突')
        elif not conflicts:
            if (last_released is not None and
                    time.monotonic() < release_visible_until):
                view.set_plan(
                    predicted['robot1'], predicted['robot2'],
                    last_released['conflicts'], last_released['hold_pose'])
                view.publish(
                    'ONLINE_CLEAR', '冲突预约已释放，持续监测剩余轨迹',
                    released=True)
            else:
                view.set_plan(
                    predicted['robot1'], predicted['robot2'], [])
                view.publish(
                    'ONLINE_MONITORING',
                    f'无动态冲突；车间距 {separation:.2f} m')

        time.sleep(period)

    return {name: robot.result for name, robot in robots.items()}


def main(args=None):
    rclpy.init(args=args)
    robot1 = BasicNavigator(node_name='trajectory_coordinator', namespace='robot1')
    robot2 = BasicNavigator(node_name='trajectory_coordinator', namespace='robot2')
    navigators = {'robot1': robot1, 'robot2': robot2}
    view = SchedulerView(robot1)

    parameters = {
        # Match the conservative real-robot-like DWB / velocity-smoother
        # limits instead of predicting with the former ideal-simulation speed.
        'nominal_speed': 0.27,
        'clearance': 0.80,
        # A generous temporal window makes the narrow-passage demonstration
        # reproducible despite controller and simulator timing jitter.
        'time_margin': 4.00,
        'hold_distance': 1.10,
        'online_period': 0.20,
        'minimum_prediction_speed': 0.08,
        'maximum_prediction_speed': 0.32,
        'emergency_clearance': 0.65,
        'release_min_separation': 1.00,
        'release_confirmation_cycles': 5,
        'robot1_priority': 0,
        'robot2_priority': 0,
        'timeout': 240.0,
        'robot1_start_x': -3.0,
        'robot1_start_y': -2.0,
        'robot1_start_yaw': 0.0,
        'robot2_start_x': -3.0,
        'robot2_start_y': 2.0,
        'robot2_start_yaw': 0.0,
        'robot1_goal_x': 3.0,
        'robot1_goal_y': -0.6,
        'robot1_goal_yaw': 0.0,
        'robot2_goal_x': 3.0,
        'robot2_goal_y': 0.6,
        'robot2_goal_yaw': 0.0,
    }
    for name, value in parameters.items():
        robot1.declare_parameter(name, value)
        parameters[name] = robot1.get_parameter(name).value

    starts = {
        'robot1': make_pose(
            robot1, parameters['robot1_start_x'],
            parameters['robot1_start_y'], parameters['robot1_start_yaw']),
        'robot2': make_pose(
            robot2, parameters['robot2_start_x'],
            parameters['robot2_start_y'], parameters['robot2_start_yaw']),
    }
    goals = {
        'robot1': make_pose(
            robot1, parameters['robot1_goal_x'],
            parameters['robot1_goal_y'], parameters['robot1_goal_yaw']),
        'robot2': make_pose(
            robot2, parameters['robot2_goal_x'],
            parameters['robot2_goal_y'], parameters['robot2_goal_yaw']),
    }
    success = False

    try:
        view.publish('WAITING_FOR_NAV2', '正在启动两套导航系统')
        # AMCL is initialized from the known simulator spawn poses.  Use a
        # bounded topic/action readiness check so one lost lifecycle service
        # response cannot leave the coordinator waiting forever.
        wait_for_nav2(robot1)
        wait_for_nav2(robot2)
        view.publish('PLANNING_TRAJECTORIES', '请求两条独立全局路径')
        # The planners receive fresh timestamps after localization startup.
        for name in ('robot1', 'robot2'):
            now = navigators[name].get_clock().now().to_msg()
            starts[name].header.stamp = now
            goals[name].header.stamp = now
        paths = {
            name: navigators[name].getPath(
                starts[name], goals[name], use_start=True)
            for name in ('robot1', 'robot2')
        }
        if any(path is None or not path.poses for path in paths.values()):
            raise RuntimeError('global planner failed to produce both paths')

        samples = {
            name: timed_samples(paths[name], float(parameters['nominal_speed']))
            for name in ('robot1', 'robot2')
        }
        robots = {
            name: RobotRuntime(
                name=name,
                navigator=navigators[name],
                path=paths[name],
                samples=samples[name],
                goal=goals[name],
                x=starts[name].pose.position.x,
                y=starts[name].pose.position.y,
                speed=float(parameters['nominal_speed']))
            for name in ('robot1', 'robot2')
        }
        subscribe_to_live_plans(
            robots, float(parameters['nominal_speed']))
        view.publish(
            'ONLINE_MONITORING', '启动双车并持续重算剩余轨迹冲突')
        results = run_online_coordination(robots, view, parameters)

        success = all(result == TaskResult.SUCCEEDED
                      for result in results.values())
        view.publish(
            'COMPLETE' if success else 'FAILED',
            ', '.join(f'{name}={result_name(result)}'
                      for name, result in sorted(results.items())),
            released=True)
        # Keep the transient-local publisher alive so RViz retains the final
        # predicted paths and red/green conflict-zone state until launch is
        # stopped.  This also supports RViz being restarted after completion.
        while rclpy.ok():
            view.publish(
                'COMPLETE' if success else 'FAILED',
                ', '.join(f'{name}={result_name(result)}'
                          for name, result in sorted(results.items())),
                released=True)
            time.sleep(0.5)
    except KeyboardInterrupt:
        # launch has already started shutting down the ROS context; there is
        # no active task left to cancel safely here.
        pass
    except (TimeoutError, RuntimeError) as error:
        robot1.get_logger().error(f'[SCHEDULER] {error}')
        if rclpy.ok():
            robot1.cancelTask()
            robot2.cancelTask()
    finally:
        robot1.destroy_node()
        robot2.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()

    if not success:
        sys.exit(1)


if __name__ == '__main__':
    main()
