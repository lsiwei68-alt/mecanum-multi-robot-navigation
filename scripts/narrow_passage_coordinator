#!/usr/bin/env python3
"""Central right-of-way coordinator for the single-lane passage demo."""

import math
import sys
import time

from geometry_msgs.msg import PoseStamped
from nav2_simple_commander.robot_navigator import BasicNavigator, TaskResult
import rclpy
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import String
from visualization_msgs.msg import Marker, MarkerArray


def make_pose(navigator, x, y, yaw=0.0):
    pose = PoseStamped()
    pose.header.frame_id = 'map'
    pose.header.stamp = navigator.get_clock().now().to_msg()
    pose.pose.position.x = float(x)
    pose.pose.position.y = float(y)
    pose.pose.orientation.z = math.sin(yaw / 2.0)
    pose.pose.orientation.w = math.cos(yaw / 2.0)
    return pose


def result_name(result):
    if result == TaskResult.SUCCEEDED:
        return 'SUCCEEDED'
    if result == TaskResult.CANCELED:
        return 'CANCELED'
    if result == TaskResult.FAILED:
        return 'FAILED'
    return f'UNKNOWN({result})'


class SchedulerView:
    def __init__(self, node):
        qos = QoSProfile(depth=1)
        qos.reliability = ReliabilityPolicy.RELIABLE
        qos.durability = DurabilityPolicy.TRANSIENT_LOCAL
        self.node = node
        self.state_publisher = node.create_publisher(
            String, '/coordination/state', qos)
        self.marker_publisher = node.create_publisher(
            MarkerArray, '/coordination/markers', qos)
        self.last_state = None

    def publish(self, state, detail, occupied=True):
        if state != self.last_state:
            self.node.get_logger().info(f'[SCHEDULER] {state}: {detail}')
            self.last_state = state

        state_message = String()
        state_message.data = f'{state}: {detail}'
        self.state_publisher.publish(state_message)

        now = self.node.get_clock().now().to_msg()
        markers = MarkerArray()

        corridor = Marker()
        corridor.header.frame_id = 'map'
        corridor.header.stamp = now
        corridor.ns = 'coordination'
        corridor.id = 0
        corridor.type = Marker.CUBE
        corridor.action = Marker.ADD
        corridor.pose.position.x = 0.0
        corridor.pose.position.y = 0.0
        corridor.pose.position.z = 0.025
        corridor.pose.orientation.w = 1.0
        corridor.scale.x = 2.4
        corridor.scale.y = 1.25
        corridor.scale.z = 0.05
        corridor.color.r = 0.95 if occupied else 0.10
        corridor.color.g = 0.20 if occupied else 0.85
        corridor.color.b = 0.10
        corridor.color.a = 0.28
        markers.markers.append(corridor)

        waiting = Marker()
        waiting.header.frame_id = 'map'
        waiting.header.stamp = now
        waiting.ns = 'coordination'
        waiting.id = 1
        waiting.type = Marker.CYLINDER
        waiting.action = Marker.ADD
        waiting.pose.position.x = -3.0
        waiting.pose.position.y = 2.0
        waiting.pose.position.z = 0.03
        waiting.pose.orientation.w = 1.0
        waiting.scale.x = 0.9
        waiting.scale.y = 0.9
        waiting.scale.z = 0.06
        waiting.color.r = 1.0
        waiting.color.g = 0.75
        waiting.color.b = 0.05
        waiting.color.a = 0.40 if occupied else 0.12
        markers.markers.append(waiting)

        label = Marker()
        label.header.frame_id = 'map'
        label.header.stamp = now
        label.ns = 'coordination'
        label.id = 2
        label.type = Marker.TEXT_VIEW_FACING
        label.action = Marker.ADD
        label.pose.position.x = 0.0
        label.pose.position.y = 0.0
        label.pose.position.z = 1.35
        label.pose.orientation.w = 1.0
        label.scale.z = 0.32
        label.color.r = 1.0
        label.color.g = 1.0
        label.color.b = 1.0
        label.color.a = 1.0
        label.text = f'{state}\n{detail}'
        markers.markers.append(label)

        arrow = Marker()
        arrow.header.frame_id = 'map'
        arrow.header.stamp = now
        arrow.ns = 'coordination'
        arrow.id = 3
        arrow.type = Marker.ARROW
        arrow.action = Marker.ADD
        arrow.pose.position.x = -1.0
        arrow.pose.position.y = 0.0
        arrow.pose.position.z = 0.15
        arrow.pose.orientation.w = 1.0
        arrow.scale.x = 2.0
        arrow.scale.y = 0.12
        arrow.scale.z = 0.18
        arrow.color.r = 0.20
        arrow.color.g = 0.85
        arrow.color.b = 1.0
        arrow.color.a = 0.9
        markers.markers.append(arrow)

        self.marker_publisher.publish(markers)


def main(args=None):
    rclpy.init(args=args)
    robot1 = BasicNavigator(
        node_name='passage_scheduler_robot1', namespace='robot1')
    robot2 = BasicNavigator(
        node_name='passage_scheduler_robot2', namespace='robot2')
    view = SchedulerView(robot1)

    for node in (robot1, robot2):
        node.declare_parameter('release_x', 1.0)
        node.declare_parameter('timeout', 240.0)

    release_x = float(robot1.get_parameter('release_x').value)
    timeout = float(robot1.get_parameter('timeout').value)

    initial1 = make_pose(robot1, -3.0, -2.0)
    initial2 = make_pose(robot2, -3.0, 2.0)
    robot1.setInitialPose(initial1)
    robot2.setInitialPose(initial2)

    view.publish('WAITING_FOR_NAV2', '正在启动两套导航系统')
    robot1.waitUntilNav2Active()
    robot2.waitUntilNav2Active()

    goal1 = make_pose(robot1, 3.0, -0.6)
    goal2 = make_pose(robot2, 3.0, 0.6)
    robot1.goToPose(goal1)
    view.publish(
        'ROBOT1_GRANTED',
        'robot1 获得通行权；robot2 在黄色等待区让行')

    start = time.monotonic()
    released = False
    done1 = False
    done2 = False

    try:
        while rclpy.ok() and not released:
            done1 = robot1.isTaskComplete()
            feedback = robot1.getFeedback()
            current_x = None
            if feedback is not None:
                current_x = feedback.current_pose.pose.position.x
            if current_x is not None and current_x >= release_x:
                released = True
            elif done1:
                released = robot1.getResult() == TaskResult.SUCCEEDED

            if time.monotonic() - start > timeout:
                raise TimeoutError('robot1 did not clear the passage in time')
            view.publish(
                'ROBOT2_YIELDING',
                'robot1 正在通过狭窄通道；robot2 保持等待')
            time.sleep(0.1)

        if not released:
            raise RuntimeError('robot1 failed before releasing the passage')

        robot2.goToPose(goal2)
        view.publish(
            'PASSAGE_RELEASED',
            'robot1 已驶出预约区；robot2 获得通行权', occupied=False)

        while rclpy.ok() and not (done1 and done2):
            done1 = done1 or robot1.isTaskComplete()
            done2 = done2 or robot2.isTaskComplete()
            if time.monotonic() - start > timeout:
                raise TimeoutError('coordinated navigation timed out')
            view.publish(
                'ROBOT2_GRANTED',
                'robot2 正在通过；robot1 前往编队槽位', occupied=False)
            time.sleep(0.1)

        result1 = robot1.getResult()
        result2 = robot2.getResult()
        success = (result1 == TaskResult.SUCCEEDED and
                   result2 == TaskResult.SUCCEEDED)
        view.publish(
            'COMPLETE' if success else 'FAILED',
            f'robot1={result_name(result1)}, robot2={result_name(result2)}',
            occupied=False)
        time.sleep(1.0)
    except (KeyboardInterrupt, TimeoutError, RuntimeError) as error:
        robot1.get_logger().error(f'[SCHEDULER] {error}')
        robot1.cancelTask()
        robot2.cancelTask()
        success = False
    finally:
        robot1.destroy_node()
        robot2.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()

    if not success:
        sys.exit(1)


if __name__ == '__main__':
    main()
