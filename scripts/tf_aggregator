#!/usr/bin/env python3
"""Merge the two namespaced TF topics into the standard RViz TF topics."""

import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from tf2_msgs.msg import TFMessage


class TfAggregator(Node):
    def __init__(self):
        super().__init__('tf_aggregator')

        dynamic_sub_qos = QoSProfile(depth=100)
        dynamic_sub_qos.reliability = ReliabilityPolicy.BEST_EFFORT
        dynamic_pub_qos = QoSProfile(depth=100)
        dynamic_pub_qos.reliability = ReliabilityPolicy.RELIABLE
        static_qos = QoSProfile(depth=1)
        static_qos.reliability = ReliabilityPolicy.RELIABLE
        static_qos.durability = DurabilityPolicy.TRANSIENT_LOCAL

        self.tf_publisher = self.create_publisher(
            TFMessage, '/tf', dynamic_pub_qos)
        self.static_publisher = self.create_publisher(
            TFMessage, '/tf_static', static_qos)
        self.static_transforms = {}

        for namespace in ('robot1', 'robot2'):
            self.create_subscription(
                TFMessage, f'/{namespace}/tf', self.tf_publisher.publish,
                dynamic_sub_qos)
            self.create_subscription(
                TFMessage, f'/{namespace}/tf_static',
                self._static_callback, static_qos)

        self.get_logger().info(
            'Aggregating robot1/robot2 TF into /tf and /tf_static for RViz')

    def _static_callback(self, message):
        # A transient-local publisher only retains its latest message. Publish
        # the complete accumulated static tree so late-starting RViz instances
        # receive both robots rather than only the last robot updated.
        for transform in message.transforms:
            key = (transform.header.frame_id, transform.child_frame_id)
            self.static_transforms[key] = transform
        merged = TFMessage()
        merged.transforms = list(self.static_transforms.values())
        self.static_publisher.publish(merged)


def main(args=None):
    rclpy.init(args=args)
    node = TfAggregator()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()


if __name__ == '__main__':
    main()
