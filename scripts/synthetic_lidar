#!/usr/bin/env python3
"""Deterministic 2-D lidar for the WSL / Gazebo Fortress learning demo.

Ogre 2 GPU lidar is unreliable on some WSL graphics drivers.  This node casts
rays against the same simple arena geometry and the other robot, so Nav2 still
receives realistic LaserScan data and treats the peer robot as a moving obstacle.
"""

import math

from nav_msgs.msg import Odometry
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import LaserScan


STATIC_BOXES = (
    (-0.5, 0.5, -0.5, 0.5),
    (-2.4, -1.6, -3.45, -2.95),
    (2.0, 2.6, 1.8, 3.2),
)

NARROW_PASSAGE_BOXES = (
    (-0.15, 0.15, -4.9, -0.65),
    (-0.15, 0.15, 0.65, 4.9),
    (-2.4, -1.6, -3.45, -2.95),
    (2.0, 2.6, 1.8, 3.2),
)


def yaw_from_quaternion(q):
    return math.atan2(2.0 * (q.w * q.z + q.x * q.y),
                      1.0 - 2.0 * (q.y * q.y + q.z * q.z))


def ray_box_distance(x, y, dx, dy, box):
    xmin, xmax, ymin, ymax = box
    tmin = -math.inf
    tmax = math.inf
    for origin, direction, lower, upper in (
            (x, dx, xmin, xmax), (y, dy, ymin, ymax)):
        if abs(direction) < 1e-9:
            if origin < lower or origin > upper:
                return math.inf
            continue
        a = (lower - origin) / direction
        b = (upper - origin) / direction
        tmin = max(tmin, min(a, b))
        tmax = min(tmax, max(a, b))
        if tmin > tmax:
            return math.inf
    if tmax < 0.0:
        return math.inf
    return tmin if tmin >= 0.0 else tmax


def ray_oriented_box_distance(x, y, dx, dy, cx, cy, yaw,
                              half_length=0.25, half_width=0.19):
    """Intersect a world-frame ray with the peer robot's rotated footprint."""
    cosine = math.cos(yaw)
    sine = math.sin(yaw)
    offset_x = x - cx
    offset_y = y - cy
    local_x = cosine * offset_x + sine * offset_y
    local_y = -sine * offset_x + cosine * offset_y
    local_dx = cosine * dx + sine * dy
    local_dy = -sine * dx + cosine * dy
    return ray_box_distance(
        local_x, local_y, local_dx, local_dy,
        (-half_length, half_length, -half_width, half_width))


class SyntheticLidar(Node):
    def __init__(self):
        super().__init__('synthetic_lidar')
        self.declare_parameter('robot_name', 'robot1')
        self.declare_parameter('other_robot', '')
        self.declare_parameter('scenario', 'arena')
        self.robot_name = self.get_parameter('robot_name').value
        self.other_robot = self.get_parameter('other_robot').value
        scenario = self.get_parameter('scenario').value
        self.static_boxes = (NARROW_PASSAGE_BOXES
                             if scenario == 'narrow_passage'
                             else STATIC_BOXES)
        self.own_pose = None
        self.other_pose = None
        self.create_subscription(
            Odometry, f'/{self.robot_name}/odom', self._own_odom, 10)
        if self.other_robot:
            self.create_subscription(
                Odometry, f'/{self.other_robot}/odom', self._other_odom, 10)
        self.publisher = self.create_publisher(
            LaserScan, 'scan', qos_profile_sensor_data)
        self.static_publisher = self.create_publisher(
            LaserScan, 'scan_static', qos_profile_sensor_data)
        self.create_timer(0.1, self._publish_scan)

    @staticmethod
    def _pose(message):
        pose = message.pose.pose
        return (pose.position.x, pose.position.y,
                yaw_from_quaternion(pose.orientation))

    def _own_odom(self, message):
        self.own_pose = self._pose(message)

    def _other_odom(self, message):
        self.other_pose = self._pose(message)

    def _publish_scan(self):
        if self.own_pose is None:
            return
        x, y, yaw = self.own_pose
        message = LaserScan()
        message.header.stamp = self.get_clock().now().to_msg()
        message.header.frame_id = f'{self.robot_name}/lidar_link'
        message.angle_min = -math.pi
        message.angle_max = math.pi
        message.angle_increment = 2.0 * math.pi / 360.0
        message.time_increment = 0.0
        message.scan_time = 0.1
        message.range_min = 0.12
        message.range_max = 12.0

        ranges = []
        static_ranges = []
        walls = (-4.9, 4.9, -4.9, 4.9)
        for index in range(360):
            angle = yaw + message.angle_min + index * message.angle_increment
            dx = math.cos(angle)
            dy = math.sin(angle)
            distance = ray_box_distance(x, y, dx, dy, walls)
            for box in self.static_boxes:
                distance = min(distance, ray_box_distance(x, y, dx, dy, box))
            static_ranges.append(max(message.range_min,
                                     min(message.range_max, distance)))
            if self.other_pose is not None:
                distance = min(distance, ray_oriented_box_distance(
                    x, y, dx, dy, self.other_pose[0], self.other_pose[1],
                    self.other_pose[2]))
            ranges.append(max(message.range_min,
                              min(message.range_max, distance)))
        message.ranges = ranges
        self.publisher.publish(message)
        static_message = LaserScan()
        static_message.header = message.header
        static_message.angle_min = message.angle_min
        static_message.angle_max = message.angle_max
        static_message.angle_increment = message.angle_increment
        static_message.time_increment = message.time_increment
        static_message.scan_time = message.scan_time
        static_message.range_min = message.range_min
        static_message.range_max = message.range_max
        static_message.ranges = static_ranges
        self.static_publisher.publish(static_message)


def main(args=None):
    rclpy.init(args=args)
    node = SyntheticLidar()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()


if __name__ == '__main__':
    main()
